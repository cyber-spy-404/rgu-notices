# ==============================================================================
# Raiganj University Notice & SMTP Dispatcher - Environment Configuration
# Copy this file to .env and configure your secret credentials.
# NEVER commit the actual .env file or .secret_key into Git!
# ==============================================================================

# Flask Session & Master Encryption Keys
FLASK_SECRET_KEY=generate_a_random_secret_string_here
APP_SECRET_KEY=generate_a_random_encryption_key_here

# Google Group Destination Broadcast
GOOGLE_GROUP_EMAIL=your-department-group@googlegroups.com

# Gmail SMTP Dispatcher Credentials
SENDER_EMAIL=your-authorized-account@gmail.com
SMTP_USER=your-authorized-account@gmail.com
# 16-character App Password generated at: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx xxxx xxxx xxxx

# Optional SMTP Host & Port (defaults to Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ==============================================================================
# External Cloud Database Configuration (PostgreSQL / Supabase / Neon / Render)
# Configure DATABASE_URL to seamlessly sync local, Render, and GitHub Actions.
# When set, mailed and pending notices, logs, and settings sync with zero lag.
# ==============================================================================
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

